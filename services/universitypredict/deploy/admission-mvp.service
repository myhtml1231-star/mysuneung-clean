[Unit]
Description=Admission Predictor MVP
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/admission-predictor
ExecStart=/usr/bin/python3 /root/admission-predictor/web_mvp/server_v4.py --host 127.0.0.1 --port 8080
Restart=on-failure
RestartSec=2
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
